# Personal Access Token GitHub (scope: repo) - JANGAN pernah commit token asli!
GITHUB_TOKEN=

# Pemilik repo, mis. "budi-santoso"
GITHUB_OWNER=

# Nama repo tempat menyimpan data, mis. "glukotrack-app" (boleh repo yang sama dengan project ini)
GITHUB_REPO=

# Branch tempat file data disimpan
GITHUB_BRANCH=main

# Path file JSON di dalam repo tempat semua data tracking disimpan
GITHUB_DATA_PATH=data/entries.json
